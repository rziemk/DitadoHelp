# Copy this file to `desktop/.env.macos.local` and fill in the values below.
# Do not commit the real file.

# Code signing identity installed in Keychain Access.
# Example:
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Company, Inc. (TEAMID1234)
APPLE_SIGNING_IDENTITY=

# Preferred notarization flow: App Store Connect API key.
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=

# Optional fallback notarization flow using Apple ID.
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=
