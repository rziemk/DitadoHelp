{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribeflowai",
  "version": "0.1.44",
  "identifier": "com.scribeflowai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Scribeflowai",
        "width": 1480,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 760,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/rziemk/DitadoHelp/releases/latest/download/latest.json"
      ]
    }
  }
}
